{
    "type": "sqlite",
    "path": "{DATABASE_PATH}/elearning.db",
    "options": {
        "create_if_not_exists": true,
        "foreign_keys": true,
        "journal_mode": "WAL"
    },
    "mysql": {
        "host": "localhost",
        "database": "elearning",
        "username": "",
        "password": "",
        "charset": "utf8mb4"
    },
    "postgresql": {
        "host": "localhost",
        "database": "elearning",
        "username": "",
        "password": "",
        "port": 5432
    },
    "backup": {
        "enabled": true,
        "frequency": "daily",
        "retention_days": 30,
        "path": "{DATABASE_PATH}/backups/"
    }
}