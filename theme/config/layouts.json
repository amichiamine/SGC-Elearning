{
    "base": {
        "body_background": "linear-gradient(135deg, #4A90E2 0%, #7ED4AD 100%)",
        "min_height": "100vh",
        "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "color": "#FFFFFF"
    },
    "admin": {
        "sidebar": {
            "width": "250px",
            "background": "rgba(255, 255, 255, 0.1)",
            "backdrop_filter": "blur(20px)",
            "border_right": "1px solid rgba(255, 255, 255, 0.1)"
        },
        "main_content": {
            "margin_left": "250px",
            "padding": "2rem"
        },
        "header": {
            "height": "70px",
            "background": "rgba(255, 255, 255, 0.05)",
            "backdrop_filter": "blur(15px)"
        }
    },
    "student": {
        "header": {
            "height": "80px",
            "background": "rgba(255, 255, 255, 0.1)",
            "backdrop_filter": "blur(20px)"
        },
        "main_content": {
            "padding": "2rem",
            "max_width": "1200px",
            "margin": "0 auto"
        }
    },
    "instructor": {
        "toolbar": {
            "height": "60px",
            "background": "rgba(126, 212, 173, 0.2)",
            "backdrop_filter": "blur(15px)"
        },
        "content_area": {
            "display": "grid",
            "grid_columns": "1fr 300px",
            "gap": "2rem",
            "padding": "2rem"
        }
    },
    "public": {
        "hero_section": {
            "min_height": "60vh",
            "display": "flex",
            "align_items": "center",
            "justify_content": "center",
            "text_align": "center"
        },
        "content_section": {
            "padding": "4rem 2rem",
            "max_width": "1200px",
            "margin": "0 auto"
        }
    },
    "auth": {
        "container": {
            "min_height": "100vh",
            "display": "flex",
            "align_items": "center",
            "justify_content": "center",
            "padding": "2rem"
        },
        "form_wrapper": {
            "max_width": "400px",
            "width": "100%",
            "background": "rgba(255, 255, 255, 0.15)",
            "backdrop_filter": "blur(20px)",
            "border_radius": "1.5rem",
            "padding": "2.5rem",
            "border": "1px solid rgba(255, 255, 255, 0.2)",
            "shadow": "0 16px 48px 0 rgba(74, 144, 226, 0.25)"
        }
    }
}