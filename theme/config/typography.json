{
    "fonts": {
        "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "secondary": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
        "monospace": "'Monaco', 'Menlo', 'Ubuntu Mono', monospace"
    },
    "font_sizes": {
        "xs": "0.75rem",
        "sm": "0.875rem", 
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem",
        "6xl": "3.75rem"
    },
    "font_weights": {
        "thin": 100,
        "extralight": 200,
        "light": 300,
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800,
        "black": 900
    },
    "line_heights": {
        "tight": 1.25,
        "snug": 1.375,
        "normal": 1.5,
        "relaxed": 1.625,
        "loose": 2
    },
    "headings": {
        "h1": {
            "size": "3rem",
            "weight": 300,
            "line_height": 1.2,
            "margin_bottom": "1.5rem"
        },
        "h2": {
            "size": "2.25rem",
            "weight": 400,
            "line_height": 1.3,
            "margin_bottom": "1.25rem"
        },
        "h3": {
            "size": "1.875rem",
            "weight": 500,
            "line_height": 1.4,
            "margin_bottom": "1rem"
        },
        "h4": {
            "size": "1.5rem",
            "weight": 500,
            "line_height": 1.4,
            "margin_bottom": "0.75rem"
        },
        "h5": {
            "size": "1.25rem",
            "weight": 600,
            "line_height": 1.5,
            "margin_bottom": "0.5rem"
        },
        "h6": {
            "size": "1.125rem",
            "weight": 600,
            "line_height": 1.5,
            "margin_bottom": "0.5rem"
        }
    }
}